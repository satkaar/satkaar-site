# Variables d'environnement pour satkaar-site
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,satkaar.fr

# URL canonique du site (utilisée pour Open Graph + sitemap)
SITE_URL=https://satkaar.fr

# Postgres en prod (sinon SQLite local)
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DATABASE_SSL_REQUIRE=true

# Email — laisser le backend console en dev
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@satkaar.fr
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@satkaar.fr
# CONTACT_NOTIFICATION_EMAIL=contact@satkaar.fr

# Superuser auto-créé au démarrage du conteneur (optionnel)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@satkaar.fr
